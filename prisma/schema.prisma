generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())

  queries   Query[]

  @@map("users")
}

model Query {
  id        String   @id @default(uuid())
  userId    String?
  text      String
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("medical_queries")
}
